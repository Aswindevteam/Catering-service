{
  "name": "wedding-feast-backend",
  "version": "1.0.0",
  "description": "Cloudflare Workers REST API with D1 and R2 for Wedding Feast Catering",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply wedding-feast-db --local",
    "migrate:remote": "wrangler d1 migrations apply wedding-feast-db --remote",
    "migrate:db:local": "wrangler d1 migrations apply wedding-feast-db --local",
    "migrate:db:remote": "wrangler d1 migrations apply wedding-feast-db --remote",
    "seed:expanded:remote": "wrangler d1 execute wedding-feast-db --remote --file ./migrations/0005_expanded_wedding_menu_and_settings.sql",
    "seed:expanded:local": "wrangler d1 execute wedding-feast-db --local --file ./migrations/0005_expanded_wedding_menu_and_settings.sql",
    "d1:create": "wrangler d1 create wedding-feast-db",
    "d1:list": "wrangler d1 list",
    "r2:create": "wrangler r2 bucket create wedding-feast-images",
    "deployments": "wrangler deployments list",
    "tail": "wrangler tail",
    "types": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.166.0"
  }
}
